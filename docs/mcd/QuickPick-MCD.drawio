        <mxCell id="legend" value="PK : identifiant     FK : référence     ? : facultatif     1,1 : exactement un     0,1 : zéro ou un     0,N : zéro à plusieurs" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#18344B;fontFamily=Segoe UI;">
